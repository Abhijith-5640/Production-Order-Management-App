<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <AssemblyName>NexusProd.Api</AssemblyName>
    <RootNamespace>NexusProd.Api</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="MySqlConnector" Version="2.3.7" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.10" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.8.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.1.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\default_db_config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\default_db_config.json" />
  </ItemGroup>

  <!-- Run the Vite production build before dotnet builds, so the
       bundled SPA is always present in wwwroot/. -->
  <Target Name="NpmBuildClient" BeforeTargets="BeforeBuild" Condition=" '$(SkipNpmBuild)' != 'true' AND Exists('..\..\client\package.json') ">
    <Exec Command="npm --prefix ..\..\client run build" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <!-- Copy the SPA build output into the bin/wwwroot folder so a plain
       `dotnet build` (not just `dotnet publish`) yields a runnable
       single-folder app. -->
  <Target Name="CopySpaToOutput" AfterTargets="Build" Condition=" Exists('wwwroot') ">
    <!-- Remove stale hashed files in the bin's wwwroot to keep content aligned with source -->
    <ItemGroup>
      <_StaleSpaFiles Include="$(OutDir)wwwroot\**\*.*" />
    </ItemGroup>
    <Delete Files="@(_StaleSpaFiles)" Condition="!$([System.IO.File]::Exists('%(RootDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)'))" />

    <ItemGroup>
      <_SpaFiles Include="wwwroot\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_SpaFiles)"
          DestinationFiles="@(_SpaFiles->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
